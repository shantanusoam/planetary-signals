# Copy this file to .env.local for local development. Never commit real keys.

# Adapter is implemented; create a free key at https://docs.openaq.org/using-the-api/api-key
OPENAQ_API_KEY=

# Adapter is implemented; request a personal key from https://ebird.org/api/keygen
EBIRD_API_KEY=
# Optional bounded country/region list (maximum eight).
EBIRD_REGIONS=IN,US,BR,ZA,AU

# Point terrain probe is implemented; create a free account/key at
# https://opentopography.org/developers
OPENTOPOGRAPHY_API_KEY=

# Optional. Anonymous USGS Water access works today; a key raises rate limits.
# https://api.waterdata.usgs.gov/docs/api-key/
USGS_WATER_API_KEY=
